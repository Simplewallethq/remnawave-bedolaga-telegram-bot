# Игнорируем все файлы и папки по умолчанию
*
docker-compose.override.yml

# Исключения: разрешаем только нужные файлы
!.dockerignore
!.env.example
!install_bot.sh
!Dockerfile
!app-config.json
!main.py
!requirements.txt
!docs/
!docs/**
!migrations/
!migrations/**


# Разрешаем папку app/ и все её содержимое рекурсивно
!app/
!app/**
!tests/
!tests/**
!scripts/
!scripts/enable_autopay_for_all.py
!images/
!images/**
# Конструктор VPN-ботов: обложки бота и мини-апп (собирается в Dockerfile)
!assets/
!assets/constructor/
!assets/constructor/**
!constructor_web/
!constructor_web/**
constructor_web/node_modules/
constructor_web/dist/

# Дополнительно разрешаем README и лицензию (опционально)
!README.md
!LICENSE

# Разрешаем .gitignore чтобы он попал в репозиторий
!.gitignore

# Внутри разрешенных папок игнорируем служебные файлы
app/__pycache__/
app/**/__pycache__/
app/**/*.pyc
app/**/*.pyo
app/**/*.pyd
*.pyc
*.pyo
*.pyd
.env

logo.png
docker-compose.yml
mirrors_bots.yaml
fromProd/
research/
